{
  "name": "@egonitida/core",
  "version": "0.0.1",
  "description": "Simulation core of EgoNitida, deterministic on every host.",
  "keywords": [
    "deterministic",
    "effect",
    "egonitida",
    "engine",
    "game-engine",
    "real-time",
    "simulation"
  ],
  "homepage": "https://egonitida.com",
  "bugs": {
    "url": "https://github.com/egonitida/egonitida/issues"
  },
  "license": "MIT",
  "author": "Filip Falcon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egonitida/egonitida.git",
    "directory": "libraries/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    "./Machine": {
      "@egonitida/source": "./src/Machine.generated.ts",
      "types": "./dist/Machine.d.mts",
      "default": "./dist/Machine.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run check --workspace @egonitida/theory && vp pack"
  },
  "devDependencies": {
    "@egonitida/theory": "0.0.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
