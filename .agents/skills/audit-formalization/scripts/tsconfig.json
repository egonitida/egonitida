{
  "extends": "../../../../tsconfig.base.json",
  "include": ["**/*.ts"],
  "compilerOptions": {
    "lib": ["es2025"], // Built-in API checked against Node.js 26.
    "module": "nodenext", // Imports resolved by Node.js itself.
    "types": ["node"], // Host API checked against Node.js 26.
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node",
          "effect/FileSystem",
          "effect/Path",
          "effect/cli"
        ] // Unstable API of Effect allowed for the reader.
      }
    ]
  }
}
