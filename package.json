{
  "name": "egonitida",
  "version": "0.0.0",
  "private": true,
  "description": "EgoNitida is a real-time 3D engine for web applications and games.",
  "homepage": "https://egonitida.com",
  "bugs": {
    "url": "https://github.com/egonitida/egonitida/issues"
  },
  "license": "MIT",
  "author": "Filip Falcon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egonitida/egonitida.git"
  },
  "workspaces": [
    "applications/*",
    "libraries/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.53.1",
    "@effect/vitest": "4.0.5",
    "effect": "4.0.5",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  }
}
